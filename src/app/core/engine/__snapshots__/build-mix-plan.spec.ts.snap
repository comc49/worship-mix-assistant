    {
      "coachingNotes": [],
      "compressor": {
        "attackMs": {
          "listenFor": "If words sound dull at the start, lengthen the attack.",
          "provenance": [
            {
              "description": "Lead vocal baseline: 15 ms",
              "source": "Baseline",
              "valueAfter": 15,
            },
          ],
          "range": {
            "max": 30,
            "min": 10,
          },
          "unit": "ms",
          "value": 15,
          "why": "Slow enough to let consonants through so words stay clear.",
        },
        "gainReductionDb": {
          "listenFor": "Loud phrases should sit in the mix instead of jumping out. Quiet phrases should show little or no reduction.",
          "provenance": [
            {
              "description": "Lead vocal baseline: 4 dB",
              "source": "Baseline",
              "valueAfter": 4,
            },
          ],
          "range": {
            "max": 6,
            "min": 3,
          },
          "unit": "dB",
          "value": 4,
          "why": "About 4 dB on loud phrases keeps the vocal on top without lifting stage noise much.",
        },
        "makeupGain": {
          "listenFor": "The vocal may seem slightly quieter with the compressor in. Use the fader to make it up, not makeup gain.",
          "value": "None (leave makeup gain at 0)",
          "why": "With wedges, makeup gain raises the quiet moments in the monitors too, which is when feedback starts.",
        },
        "ratio": {
          "listenFor": "If the voice sounds flat and lifeless, lower the ratio.",
          "provenance": [
            {
              "description": "Lead vocal baseline: 3:1",
              "source": "Baseline",
              "valueAfter": 3,
            },
          ],
          "range": {
            "max": 4,
            "min": 2,
          },
          "unit": ":1",
          "value": 3,
          "why": "A moderate ratio evens out phrases without sounding squashed.",
        },
        "releaseMs": {
          "listenFor": "If you hear the level "breathing" between words, lengthen the release.",
          "provenance": [
            {
              "description": "Lead vocal baseline: 120 ms",
              "source": "Baseline",
              "valueAfter": 120,
            },
          ],
          "range": {
            "max": 200,
