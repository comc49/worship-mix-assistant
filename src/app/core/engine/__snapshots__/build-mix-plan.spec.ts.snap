  "dcas": [
    {
      "holdsFxReturns": false,
      "id": "leadVocal",
      "label": "Lead Vocal",
      "memberChannelIds": [
        "m-vocalist-a:leadVocal.mic",
      ],
      "why": "The one fader you ride all service.",
    },
    {
      "holdsFxReturns": false,
      "id": "harmonyVocals",
      "label": "Harmony Vocals",
      "memberChannelIds": [
        "m-vocalist-b:harmonyVocal.mic",
        "m-vocalist-c:harmonyVocal.mic",
      ],
      "why": "Moves all harmonies together under the lead.",
    },
    {
      "holdsFxReturns": false,
      "id": "lowEnd",
      "label": "Low End",
      "memberChannelIds": [
        "m-bass:bassGuitar.di",
      ],
      "why": "Kick and bass together: push this into a climax instead of pushing everything.",
    },
    {
      "holdsFxReturns": false,
      "id": "energy",
      "label": "Energy",
      "memberChannelIds": [
        "m-drums:electronicDrums.stereo",
        "m-electric:electricGuitar.modeler",
      ],
      "why": "The sources that lift a chorus: snare, toms, cymbals and electric guitar.",
    },
    {
      "holdsFxReturns": false,
      "id": "keysAndPads",
      "label": "Keys and Pads",
      "memberChannelIds": [
        "m-keys:keys.di",
        "m-pad:padSynth.di",
      ],
      "why": "Pull this down when the vocal is buried.",
    },
    {
      "holdsFxReturns": false,
      "id": "guitars",
      "label": "Guitars",
      "memberChannelIds": [
        "m-vocalist-a:acousticGuitar.di",
        "m-electric:electricGuitar.modeler",
      ],
      "why": "Acoustic and electric guitars together.",
    },
    {
      "holdsFxReturns": false,
      "id": "drums",
      "label": "Drums",
      "memberChannelIds": [
        "m-drums:electronicDrums.stereo",
      ],
      "why": "Every drum channel on one fader.",
    },
    {
      "holdsFxReturns": true,
      "id": "fxReturns",
      "label": "FX Returns",
      "memberChannelIds": [],
      "why": "One fader to pull all reverb and delay down between songs or when someone speaks.",
    },
  ],
  "ensembleAdvice": [
    "Kick and bass share the low end. Ask the bassist to lock their notes to the kick pattern. Two parts playing together sound like one strong low end.",
    "Keys leave the low notes to the bass guitar. Ask the keys player to play the left hand higher, or leave it out, while the bass guitar is playing.",
    "Keys and electric guitar share the middle. Ask the keys and the electric guitar to play in different registers: when one plays low chords, the other plays higher.",
    "Acoustic guitar leaves room for the lead vocal. Ask the guitarist to strum more simply during verses so the words stay clear.",
    "Acoustic guitar is rhythm in a full band. With bass and drums playing, the acoustic guitar's job is rhythm and sparkle, not fullness.",
    "Pad sits under the keys. Ask the pad player to hold fewer notes, and higher, while the keys are playing chords.",
  ],
  "groupBuses": [
    {
      "id": "vocals",
      "label": "Vocals",
      "memberChannelIds": [
        "m-vocalist-a:leadVocal.mic",
        "m-vocalist-b:harmonyVocal.mic",
        "m-vocalist-c:harmonyVocal.mic",
      ],
      "monoIsAcceptable": true,
      "preferredWidth": "stereo",
      "priority": 1,
      "processingNotes": [],
      "why": "One place to control all vocals together.",
    },
    {
      "id": "guitars",
      "label": "Guitars",
      "memberChannelIds": [
        "m-vocalist-a:acousticGuitar.di",
        "m-electric:electricGuitar.modeler",
      ],
      "monoIsAcceptable": true,
      "preferredWidth": "stereo",
      "priority": 3,
      "processingNotes": [],
      "why": "One place to control the guitars.",
    },
    {
      "id": "keys",
      "label": "Keys",
      "memberChannelIds": [
        "m-keys:keys.di",
        "m-pad:padSynth.di",
      ],
      "monoIsAcceptable": false,
      "preferredWidth": "stereo",
      "priority": 4,
      "processingNotes": [],
      "why": "One place to control keys and pads, keeping their stereo spread.",
    },
  ],
  "housePrinciples": [
    "Arrangement beats EQ. If two sources fight, first ask who should play less, before any fader or EQ move.",
    "Establish kick and bass first. Do not high-pass and thin everything out before the low-end foundation is solid.",
    "In a reverberant room, fewer simultaneous sources beats lower faders.",
    "Set the ceiling first: set fader positions at the loudest moment of the loudest song, then work backward.",
    "Ride up into a climax with the Low End and Energy DCAs instead of pushing everything.",
    "Main bus: a limiter for protection, with the compressor off. Over-compressing the main bus flattens builds.",
  ],
  "insertEffects": [
    {
      "family": "deEsser",
      "fedByChannelIds": [],
      "id": "deEsser",
      "insertOnChannelId": "m-vocalist-a:leadVocal.mic",
      "label": "De-esser on the lead vocal",
      "listenFor": "Sharp "s" sounds soften. If the singer starts to lisp, it is doing too much.",
      "priority": 1,
      "timeNote": "",
      "timeSeconds": null,
