        },
        {
          "hear": "Thin, no body",
          "tryThis": "Lower the low cut by 20 Hz first. Only then consider removing a cut around 200 to 300 Hz.",
        },
        {
          "hear": "Pops on "p" and "b"",
          "tryThis": "Raise the low cut by 20 Hz and ask the singer to aim the mic slightly off to the side of the mouth.",
        },
        {
          "hear": "Words get lost under the band",
          "tryThis": "Before touching EQ: pull the keys and guitars DCAs down 2 dB. Then ride the vocal fader.",
        },
      ],
      "mixerNotes": [
        "Cardioid: put the wedge directly behind the mic, in line with the handle.",
      ],
      "subject": "Ch 7 · Lead vocal (Vocalist A)",
    },
    {
      "channelId": "m-vocalist-b:harmonyVocal.mic",
      "coachingNotes": [
        "Keep the mic one fist from your mouth, and listen for the lead vocal in your monitor to blend with.",
      ],
      "ifYouHear": [
        {
          "hear": "Muddy or woolly",
          "tryThis": "Cut 2 to 3 dB around 200 to 300 Hz, medium Q. Check the mic is not touching the lips.",
        },
        {
          "hear": "Boxy, like singing in a cardboard box",
          "tryThis": "Cut 2 to 4 dB around 300 to 500 Hz, medium Q.",
        },
        {
          "hear": "Nasal or honky",
          "tryThis": "Cut 2 to 3 dB around 800 Hz to 1.2 kHz, medium Q.",
        },
        {
          "hear": "Harsh or piercing on loud notes",
          "tryThis": "Cut 2 to 3 dB around 2.5 to 4 kHz, wide Q. Do not boost anything first.",
        },
        {
          "hear": "Sharp "s" and "t" sounds",
          "tryThis": "Use the de-esser if one is loaded. Otherwise cut 2 dB around 6 to 8 kHz, medium Q.",
        },
        {
          "hear": "Thin, no body",
          "tryThis": "Lower the low cut by 20 Hz first. Only then consider removing a cut around 200 to 300 Hz.",
        },
        {
          "hear": "Pops on "p" and "b"",
          "tryThis": "Raise the low cut by 20 Hz and ask the singer to aim the mic slightly off to the side of the mouth.",
        },
        {
          "hear": "Words get lost under the band",
          "tryThis": "Before touching EQ: pull the keys and guitars DCAs down 2 dB. Then ride the vocal fader.",
        },
      ],
      "mixerNotes": [
        "Cardioid: put the wedge directly behind the mic, in line with the handle.",
      ],
      "subject": "Ch 8 · Harmony vocal (Vocalist B)",
    },
    {
      "channelId": "m-vocalist-c:harmonyVocal.mic",
      "coachingNotes": [
        "Your blend is coming through as you sing it.",
      ],
      "ifYouHear": [
        {
          "hear": "Muddy or woolly",
          "tryThis": "Cut 2 to 3 dB around 200 to 300 Hz, medium Q. Check the mic is not touching the lips.",
        },
        {
          "hear": "Boxy, like singing in a cardboard box",
          "tryThis": "Cut 2 to 4 dB around 300 to 500 Hz, medium Q.",
        },
        {
          "hear": "Nasal or honky",
          "tryThis": "Cut 2 to 3 dB around 800 Hz to 1.2 kHz, medium Q.",
        },
        {
          "hear": "Harsh or piercing on loud notes",
          "tryThis": "Cut 2 to 3 dB around 2.5 to 4 kHz, wide Q. Do not boost anything first.",
        },
        {
          "hear": "Sharp "s" and "t" sounds",
