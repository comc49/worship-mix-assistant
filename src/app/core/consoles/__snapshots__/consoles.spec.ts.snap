          "controlRefs": [
            "eqScreen",
            "channelEqBandCount",
          ],
          "detail": {
            "listenFor": "Bass hits should sound deeper and cleaner.",
            "provenance": [],
            "range": null,
            "why": "A wooden box is boxy by nature; a small cut clears it.",
