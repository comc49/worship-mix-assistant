    {
      "id": "monitors",
      "intro": "Give each musician what they need to hear, starting low. Quiet monitors are the best protection against feedback.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": null,
          "controlRefs": [
            "monitorSendTap",
            "sendTapPoints",
            "preFaderSendIsAfterDynamics",
            "sendsScreen",
          ],
          "detail": {
            "listenFor": "Move a channel fader: that musician's monitor level must not change.",
            "provenance": [],
            "range": null,
            "why": "Monitor sends are pre-fader, so moving a channel fader for the room does not change what the musician hears. On this console that tap is after the channel compressor, so compression also reaches the monitors. With wedges, compression on a vocal also reaches the wedge unless the monitor send is taken before the compressor.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "monitors:tap",
          "instruction": "Set every monitor send to be taken at: Pre-Fader",
          "optional": false,
          "safety": "rehearsalOnly",
          "sectionId": "monitors",
          "subSteps": [],
          "subject": "All monitor sends",
          "value": "Pre-Fader",
        },
        {
          "busNumbers": [],
          "checkOnConsole": "The text is silent. The block diagram (p70) draws each send's mute ganged to the channel mute, which suggests a channel mute also cuts its sends. Confirm on the console before relying on it.",
