          ],
          "detail": {
            "listenFor": "Clean loud notes with no crunch.",
            "provenance": [],
            "range": null,
            "why": "Gain set on the loudest moment leaves room above it. The compressor settings on this sheet assume this gain.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "gain:m-bass:bassGuitar.di",
