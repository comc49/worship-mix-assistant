          "safety": "safeDuringService",
          "sectionId": "lowCuts",
          "subSteps": [],
          "subject": "Ch 1+2 · Electronic drums (stereo) (Drums)",
          "value": "30 Hz",
        },
        {
          "busNumbers": [],
          "checkOnConsole": null,
          "controlRefs": [
            "lowCutName",
            "lowCutScreen",
          ],
          "detail": {
            "listenFor": "The bass should lose nothing you can hear. If it gets smaller, lower the cut.",
            "provenance": [
              {
                "description": "Bass guitar baseline: 35 Hz",
                "source": "Baseline",
                "valueAfter": 35,
              },
            ],
            "range": "30 Hz to 50 Hz",
            "why": "Removes only the sub-rumble below the lowest bass note. The foundation stays.",
