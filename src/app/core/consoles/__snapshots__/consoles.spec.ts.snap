            ],
            "range": "40 Hz to 70 Hz",
            "why": "The cajon is the kick drum of a stripped set. Only rumble is removed.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "lowcut:m-cajon:cajon.mic",
