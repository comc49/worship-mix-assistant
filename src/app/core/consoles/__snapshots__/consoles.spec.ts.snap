  "reference": [
    {
      "channelId": "m-drums:electronicDrums.stereo",
      "coachingNotes": [],
      "ifYouHear": [
        {
          "hear": "Kick too quiet or too loud against the rest of the kit",
          "tryThis": "This cannot be fixed at the console. Ask the drummer to change the kick volume in the module's mixer.",
        },
        {
          "hear": "Cymbals harsh",
          "tryThis": "Ask the drummer to lower cymbal volume in the module. Otherwise cut 2 dB around 4 to 6 kHz, wide Q.",
        },
        {
          "hear": "Kit sounds boxy",
          "tryThis": "Cut 2 to 3 dB around 300 to 500 Hz, wide Q.",
        },
        {
          "hear": "Quiet hits disappear, loud hits jump out",
          "tryThis": "Ask the drummer to adjust pad sensitivity (velocity curve) in the module.",
        },
      ],
      "mixerNotes": [
        "The balance between kick, snare and cymbals is set inside the drum module, not on the console.",
        "If the module has a spare output, a separate kick output gives you real control of the low end. Consider it.",
      ],
      "subject": "Ch 1+2 · Electronic drums (stereo) (Drums)",
    },
    {
      "channelId": "m-bass:bassGuitar.di",
      "coachingNotes": [
        "Aim for every note at the same strength. Playing a little softer overall makes that easier.",
      ],
      "ifYouHear": [
        {
          "hear": "Boomy, one note louder than the rest",
          "tryThis": "First ask the player to play that note softer. Then cut 3 dB around 80 to 120 Hz, medium Q, sweeping to find it.",
        },
        {
          "hear": "Cannot hear which note is being played",
          "tryThis": "Boost 2 dB around 700 Hz to 1 kHz, wide Q, instead of turning the bass up.",
        },
        {
          "hear": "Clacky string noise",
          "tryThis": "Cut 2 to 3 dB around 2 to 3 kHz, medium Q.",
        },
        {
          "hear": "Bass and kick blur together",
          "tryThis": "Decide which one owns 60 to 80 Hz. Cut the other one 2 to 3 dB there.",
        },
      ],
      "mixerNotes": [
        "If single notes boom, it is usually uneven playing, not EQ. Check the compressor is working before cutting lows.",
      ],
      "subject": "Ch 3 · Bass guitar",
    },
    {
      "channelId": "m-vocalist-a:acousticGuitar.di",
      "coachingNotes": [],
      "ifYouHear": [
        {
          "hear": "Boomy or humming on certain notes",
          "tryThis": "Cut 3 dB around 150 to 250 Hz, medium Q, sweeping to find it.",
        },
        {
          "hear": "Plastic, "quacky" pickup sound",
          "tryThis": "Cut 2 to 3 dB around 1 to 1.5 kHz, medium Q.",
        },
        {
          "hear": "Harsh strumming",
          "tryThis": "Cut 2 dB around 3 to 5 kHz, wide Q.",
        },
        {
          "hear": "Fights the vocal",
          "tryThis": "Ask the guitarist to play more simply under the verses before reaching for EQ.",
        },
      ],
      "mixerNotes": [],
      "subject": "Ch 4 · Acoustic guitar (Vocalist A)",
    },
    {
      "channelId": "m-electric:electricGuitar.modeler",
      "coachingNotes": [],
      "ifYouHear": [
        {
          "hear": "Harsh or fizzy",
          "tryThis": "Cut 2 to 3 dB around 3 to 4 kHz, wide Q. If it is still fizzy, add a high cut around 8 kHz.",
        },
        {
          "hear": "Thin",
          "tryThis": "Lower the low cut by 20 Hz. Then ask the player to check the patch, because thin usually comes from the patch.",
        },
        {
          "hear": "Too loud on some songs, too quiet on others",
          "tryThis": "Ask the player to level their patches. Until then, ride the fader song by song.",
        },
        {
          "hear": "Fights the keys",
          "tryThis": "Ask one of them to move to a different register before using EQ.",
        },
      ],
      "mixerNotes": [],
      "subject": "Ch 5 · Electric guitar",
    },
    {
      "channelId": "m-keys:keys.di",
      "coachingNotes": [
        "When the bass guitar is playing, leave the low notes to them: play your left hand higher, or leave it out.",
      ],
      "ifYouHear": [
        {
          "hear": "Muddy under the band",
          "tryThis": "First ask the player to play less with the left hand. Then raise the low cut by 20 Hz.",
        },
        {
          "hear": "Fights the guitars",
          "tryThis": "Ask one of them to move up or down an octave before using EQ.",
        },
        {
          "hear": "Harsh on bright patches",
          "tryThis": "Cut 2 dB around 2.5 to 4 kHz, wide Q.",
        },
        {
          "hear": "Thin when the band drops out",
          "tryThis": "Lower the low cut by 20 Hz for that song.",
        },
      ],
      "mixerNotes": [],
      "subject": "Ch 7+8 · Keys",
    },
    {
      "channelId": "m-pad:padSynth.di",
      "coachingNotes": [],
      "ifYouHear": [
        {
          "hear": "The whole mix sounds cloudy",
          "tryThis": "Pull the pad down 3 dB before touching anything else.",
        },
        {
          "hear": "Pad swells too loud",
          "tryThis": "Ask the player to use their volume pedal, or ride the fader down.",
        },
      ],
      "mixerNotes": [],
      "subject": "Ch 9+10 · Pad",
    },
    {
      "channelId": "m-vocalist-a:leadVocal.mic",
      "coachingNotes": [],
      "ifYouHear": [
        {
          "hear": "Muddy or woolly",
          "tryThis": "Cut 2 to 3 dB around 200 to 300 Hz, medium Q. Check the mic is not touching the lips.",
        },
        {
          "hear": "Boxy, like singing in a cardboard box",
          "tryThis": "Cut 2 to 4 dB around 300 to 500 Hz, medium Q.",
        },
        {
          "hear": "Nasal or honky",
          "tryThis": "Cut 2 to 3 dB around 800 Hz to 1.2 kHz, medium Q.",
        },
        {
          "hear": "Harsh or piercing on loud notes",
          "tryThis": "Cut 2 to 3 dB around 2.5 to 4 kHz, wide Q. Do not boost anything first.",
        },
        {
          "hear": "Sharp "s" and "t" sounds",
          "tryThis": "Use the de-esser if one is loaded. Otherwise cut 2 dB around 6 to 8 kHz, medium Q.",
        },
        {
          "hear": "Thin, no body",
          "tryThis": "Lower the low cut by 20 Hz first. Only then consider removing a cut around 200 to 300 Hz.",
        },
        {
          "hear": "Pops on "p" and "b"",
          "tryThis": "Raise the low cut by 20 Hz and ask the singer to aim the mic slightly off to the side of the mouth.",
        },
        {
          "hear": "Words get lost under the band",
          "tryThis": "Before touching EQ: pull the keys and guitars DCAs down 2 dB. Then ride the vocal fader.",
        },
      ],
      "mixerNotes": [
        "Cardioid: put the wedge directly behind the mic, in line with the handle.",
      ],
      "subject": "Ch 11 · Lead vocal (Vocalist A)",
    },
    {
      "channelId": "m-vocalist-b:harmonyVocal.mic",
      "coachingNotes": [
        "Keep the mic one fist from your mouth, and listen for the lead vocal in your monitor to blend with.",
      ],
      "ifYouHear": [
        {
          "hear": "Muddy or woolly",
          "tryThis": "Cut 2 to 3 dB around 200 to 300 Hz, medium Q. Check the mic is not touching the lips.",
        },
        {
          "hear": "Boxy, like singing in a cardboard box",
          "tryThis": "Cut 2 to 4 dB around 300 to 500 Hz, medium Q.",
        },
        {
          "hear": "Nasal or honky",
          "tryThis": "Cut 2 to 3 dB around 800 Hz to 1.2 kHz, medium Q.",
        },
        {
          "hear": "Harsh or piercing on loud notes",
          "tryThis": "Cut 2 to 3 dB around 2.5 to 4 kHz, wide Q. Do not boost anything first.",
        },
        {
          "hear": "Sharp "s" and "t" sounds",
          "tryThis": "Use the de-esser if one is loaded. Otherwise cut 2 dB around 6 to 8 kHz, medium Q.",
        },
        {
          "hear": "Thin, no body",
          "tryThis": "Lower the low cut by 20 Hz first. Only then consider removing a cut around 200 to 300 Hz.",
        },
        {
          "hear": "Pops on "p" and "b"",
          "tryThis": "Raise the low cut by 20 Hz and ask the singer to aim the mic slightly off to the side of the mouth.",
        },
        {
          "hear": "Words get lost under the band",
          "tryThis": "Before touching EQ: pull the keys and guitars DCAs down 2 dB. Then ride the vocal fader.",
        },
      ],
      "mixerNotes": [
        "Cardioid: put the wedge directly behind the mic, in line with the handle.",
      ],
      "subject": "Ch 12 · Harmony vocal (Vocalist B)",
    },
    {
      "channelId": "m-vocalist-c:harmonyVocal.mic",
      "coachingNotes": [
        "Your blend is coming through as you sing it.",
      ],
      "ifYouHear": [
        {
          "hear": "Muddy or woolly",
          "tryThis": "Cut 2 to 3 dB around 200 to 300 Hz, medium Q. Check the mic is not touching the lips.",
        },
        {
          "hear": "Boxy, like singing in a cardboard box",
          "tryThis": "Cut 2 to 4 dB around 300 to 500 Hz, medium Q.",
        },
        {
          "hear": "Nasal or honky",
          "tryThis": "Cut 2 to 3 dB around 800 Hz to 1.2 kHz, medium Q.",
        },
        {
          "hear": "Harsh or piercing on loud notes",
          "tryThis": "Cut 2 to 3 dB around 2.5 to 4 kHz, wide Q. Do not boost anything first.",
        },
        {
          "hear": "Sharp "s" and "t" sounds",
          "tryThis": "Use the de-esser if one is loaded. Otherwise cut 2 dB around 6 to 8 kHz, medium Q.",
        },
        {
          "hear": "Thin, no body",
          "tryThis": "Lower the low cut by 20 Hz first. Only then consider removing a cut around 200 to 300 Hz.",
        },
        {
          "hear": "Pops on "p" and "b"",
          "tryThis": "Raise the low cut by 20 Hz and ask the singer to aim the mic slightly off to the side of the mouth.",
        },
        {
          "hear": "Words get lost under the band",
          "tryThis": "Before touching EQ: pull the keys and guitars DCAs down 2 dB. Then ride the vocal fader.",
        },
      ],
      "mixerNotes": [
