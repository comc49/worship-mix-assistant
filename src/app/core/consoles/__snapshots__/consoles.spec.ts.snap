    {
      "id": "lowCuts",
      "intro": "Remove the low rumble each source does not need, so the kick and bass have the low end to themselves. The EQ cuts are optional: try each one and keep it only if it sounds better.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": null,
          "controlRefs": [
            "lowCutName",
            "lowCutScreen",
          ],
          "detail": {
            "listenFor": "The kick must lose nothing.",
            "provenance": [
              {
                "description": "Electronic drums (stereo) baseline: 30 Hz",
                "source": "Baseline",
                "valueAfter": 30,
              },
            ],
            "range": "20 Hz to 40 Hz",
            "why": "The kick is inside this pair, so only inaudible sub-rumble is removed.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "lowcut:m-drums:electronicDrums.stereo",
          "instruction": "Turn Low Cut on and set it to 30 Hz",
