              {
                "description": "Acoustic guitar baseline: 90 Hz",
                "source": "Baseline",
                "valueAfter": 90,
              },
              {
                "description": "+20 Hz. Higher low cut for the live room: less low-mid goes into a room that already builds it up.",
                "source": "Room",
                "valueAfter": 110,
              },
            ],
            "range": "70 Hz to 140 Hz",
            "why": "An acoustic guitar in a band is rhythm and sparkle. Its lows only crowd the bass and kick.",
