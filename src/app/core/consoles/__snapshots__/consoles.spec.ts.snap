  "sections": [
    {
      "id": "protect",
      "intro": "Save what is on the console now, so nothing you do next can lose a working setup.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": null,
          "controlRefs": [
            "saveScene",
          ],
          "detail": {
            "listenFor": "Nothing to listen for. Check the new name appears in the list.",
            "provenance": [],
            "range": null,
            "why": "If anything on this sheet goes wrong, the saved copy is the way back.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "protect:save",
          "instruction": "Save the console as it is now under a new name, so you can get back to it",
          "optional": false,
          "safety": "safeDuringService",
          "sectionId": "protect",
          "subSteps": [
            "Press the View button in the Scenes section and open the scenes tab.",
            "Turn the 2nd encoder to an empty scene slot and press it to open the save screen.",
            "Type a new name and save.",
          ],
          "subject": "Before anything else",
          "value": null,
        },
      ],
      "title": "Protect the current setup",
    },
    {
      "id": "patch",
      "intro": "Put every source on a known channel, in the same order every week, so you can find it without looking.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": "The manual only says "adjacent channel". The odd/even rule was in the brief's checked list but is not stated in this manual.",
          "controlRefs": [
            "nameChannel",
            "stereoChannels",
            "stereoLinkPairRule",
          ],
          "detail": {
            "listenFor": "Nothing to listen for.",
            "provenance": [],
            "range": null,
            "why": "Named channels in a standard order (drums, bass, guitars, keys, pads, vocals) are faster to find under pressure.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "patch:m-drums:electronicDrums.stereo",
          "instruction": "Plug left and right into channels 1 and 2, link them as a stereo pair, and name them: Electronic drums (stereo) (Drums)",
          "optional": false,
          "safety": "rehearsalOnly",
          "sectionId": "patch",
          "subSteps": [
            "Press Select on the channel.",
            "Press Home and go to the config tab.",
            "Press Utility, then choose a color and icon and type a name.",
          ],
          "subject": "Ch 1+2 · Electronic drums (stereo) (Drums)",
          "value": null,
        },
        {
