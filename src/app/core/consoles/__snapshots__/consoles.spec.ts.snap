              },
              {
                "description": "+0.4 s. A dry room gives no tail, so the plate provides it.",
                "source": "Room",
                "valueAfter": 2,
              },
            ],
            "range": "1 s to 2.4 s",
            "why": "A medium plate adds sustain to voices without a long tail.",
          },
          "effectName": "Plate Reverb",
