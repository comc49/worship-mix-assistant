    {
      "id": "gain",
      "intro": "Set each input so its loudest moment is clean. Everything after this assumes these gains. During a service, only ever turn a gain down, and only if that input is clipping.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": "The manual says gain is a Source property (p40). The exact on-screen label, and any hardware gain knob on the WING Compact, are not described.",
          "controlRefs": [
            "preampGain",
          ],
          "detail": {
            "listenFor": "No clipping on the hardest hits.",
            "provenance": [],
            "range": null,
            "why": "If the module volume moves after soundcheck, every setting on this channel is wrong.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "gain:m-drums:electronicDrums.stereo",
          "instruction": "Set the preamp gain",
          "optional": false,
          "safety": "rehearsalOnly",
          "sectionId": "gain",
          "subSteps": [
            "Set the module's output volume to about three quarters and ask the drummer not to change it.",
            "Ask the drummer to play their loudest groove with crashes.",
            "Raise the preamp gain until the loudest hits peak around -12 dB on the channel meter.",
          ],
          "subject": "Ch 1 · Electronic drums (stereo) (Drums)",
          "value": "Loudest moments peak around -12 dB",
        },
        {
          "busNumbers": [],
          "checkOnConsole": "The manual says gain is a Source property (p40). The exact on-screen label, and any hardware gain knob on the WING Compact, are not described.",
          "controlRefs": [
            "preampGain",
          ],
          "detail": {
            "listenFor": "Clean loud notes with no crunch.",
            "provenance": [],
            "range": null,
            "why": "Gain set on the loudest moment leaves room above it. The compressor settings on this sheet assume this gain.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "gain:m-bass:bassGuitar.di",
          "instruction": "Set the preamp gain",
          "optional": false,
          "safety": "rehearsalOnly",
          "sectionId": "gain",
          "subSteps": [
            "Ask the player to play their loudest part of the set.",
            "Raise the preamp gain until the loudest moments peak around -12 dB on the channel meter.",
            "If any red light shows, turn the gain down until it does not.",
          ],
          "subject": "Ch 2 · Bass guitar",
          "value": "Loudest moments peak around -12 dB",
        },
        {
