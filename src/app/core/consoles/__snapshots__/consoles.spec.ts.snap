          "controlRefs": [
            "monitorSendTap",
            "sendTapPoints",
            "preFaderSendIsAfterDynamics",
            "sendsScreen",
          ],
          "detail": {
            "listenFor": "Move a channel fader: that musician's monitor level must not change.",
            "provenance": [],
            "range": null,
            "why": "Monitor sends are pre-fader, so moving a channel fader for the room does not change what the musician hears. Check on this console whether that tap is before or after the compressor. With wedges, compression on a vocal also reaches the wedge unless the monitor send is taken before the compressor.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "monitors:tap",
          "instruction": "Set every monitor send to be taken at: TAP, with the channel TAP point at PRE FDR",
