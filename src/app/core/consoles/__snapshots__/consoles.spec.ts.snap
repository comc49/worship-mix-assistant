  "sections": [
    {
      "id": "protect",
      "intro": "Save what is on the console now, so nothing you do next can lose a working setup.",
      "steps": [
        {
          "busNumbers": [],
          "checkOnConsole": null,
          "controlRefs": [
            "saveScene",
          ],
          "detail": {
            "listenFor": "Nothing to listen for. Check the new name appears in the list.",
            "provenance": [],
            "range": null,
            "why": "If anything on this sheet goes wrong, the saved copy is the way back.",
          },
          "effectName": null,
          "fxSlot": null,
          "id": "protect:save",
          "instruction": "Save the console as it is now under a new name, so you can get back to it",
          "optional": false,
          "safety": "safeDuringService",
          "sectionId": "protect",
          "subSteps": [
            "Press LIBRARY.",
            "Open the SNAP tab.",
            "Press SAVE to store a new Snapshot of the current console.",
          ],
          "subject": "Before anything else",
          "value": null,
        },
      ],
      "title": "Protect the current setup",
    },
    {
      "id": "patch",
